# 二开叠加层：基于官方镜像（锁定 digest），只覆盖 Python 源码，不重装依赖/浏览器
# 如果改了 pyproject.toml 依赖，请在下面取消注释 pip install 行
FROM registry.cn-shanghai.aliyuncs.com/zhinian-software/xianyu-scheduler@sha256:a5c933a57e2c339e3e5d4d6cc98b15ae9617114eb2e647ddd748c34505e5bca1
COPY common   /app/common
COPY launcher /app/launcher
COPY scheduler /app/scheduler
# RUN pip install --no-cache-dir -i https://mirrors.tencentyun.com/pypi/simple <新增依赖>
